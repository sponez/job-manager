# Select the repository at startup (default: true).
# false = memory: no DB/Vault required; data is lost on restart.
# true = PostgreSQL: requires the DB/Vault settings below.
# This flag does not affect the migration command.
USE_POSTGRES=true

# Vault KV v2: mount app, path job-manager; required secrets: db_user, db_password.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=

# Credentials are substituted from Vault, with URL escaping.
DB_URL=postgres://{db_user}:{db_password}@localhost:5432/job_manager

# Optional settings (defaults shown). Explicitly empty values are invalid.
HTTP_ADDR=:8080
DB_MAX_CONNS=10
DB_MIN_CONNS=0
# Go duration, e.g. 30m or 1h; plain integer seconds are not supported.
DB_MAX_CONN_LIFETIME=1h
